+/// Temporary owned QA574 instrumentation; never included in the published PR.
+pub fn qa574_mark(event: &str, stage: u8) {
+    use std::sync::{Mutex, OnceLock};
+    use std::time::{Instant, SystemTime, UNIX_EPOCH};
+    #[derive(Default)]
+    struct Trace {
+        sequence: u64,
+        draw_stage: u8,
+        draw_serial: u64,
+        draw_ns: u128,
+        drawn: u8,
+        presented: u8,
+    }
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    static CLOCK: OnceLock<Instant> = OnceLock::new();
+    static TRACE: OnceLock<Mutex<Trace>> = OnceLock::new();
+    if !*ENABLED.get_or_init(|| std::env::var_os("RESHIKI_QA_COPY_FRAME_TRACE").is_some()) {
+        return;
+    }
+    let clock = CLOCK.get_or_init(Instant::now);
+    let mut trace = TRACE.get_or_init(|| Mutex::new(Trace::default())).lock().unwrap();
+    let now = clock.elapsed().as_nanos();
+    let current;
+    match event {
+        "dispatch_copy_pdf" => {
+            let sequence = trace.sequence + 1;
+            *trace = Trace { sequence, ..Trace::default() };
+            current = 0;
+        }
+        "status_draw" => {
+            trace.draw_stage = stage;
+            trace.draw_serial += 1;
+            trace.draw_ns = now;
+            if trace.sequence == 0 || stage == 0 || trace.drawn & (1 << stage) != 0 {
+                return;
+            }
+            trace.drawn |= 1 << stage;
+            current = stage;
+        }
+        "present_ok" => {
+            current = trace.draw_stage;
+            if trace.sequence == 0 || current == 0 || trace.presented & (1 << current) != 0 {
+                return;
+            }
+            trace.presented |= 1 << current;
+        }
+        "preparing_status_set" => {
+            if trace.sequence == 0 { return; }
+            current = 1;
+        }
+        _ => return,
+    }
+    let wall = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos();
+    eprintln!(
+        "QA574 {{\"phase\":\"{}\",\"sequence\":{},\"t_ns\":{},\"wall_ns\":{},\"stage\":{},\"draw_ns\":{},\"draw_serial\":{},\"pid\":{}}}",
+        event, trace.sequence, now, wall, current, trace.draw_ns, trace.draw_serial, std::process::id(),
+    );
+}
