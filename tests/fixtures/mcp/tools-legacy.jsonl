< {"jsonrpc":"2.0","id":7,"result":{"content":[{"text":"<structuredContent>","type":"text"},{"resource":{"mimeType":"image/svg+xml","text":"<file>","uri":"reshiki:result/drawing.svg"},"type":"resource"}],"isError":false,"structuredContent":{"validation":{"status":"valid"},"value":{"receipt":{"byte_len":"<size>","detail":null,"format":"svg"}},"versions":{"app":"<app>","document":19,"engine_protocol":"<engine>","operation_api":1},"warnings":[]}}}
