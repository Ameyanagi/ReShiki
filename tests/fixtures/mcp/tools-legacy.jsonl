> {"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"render","arguments":{"document":"<doc#1>","format":"png","max_width":null,"max_height":null,"ids":null}}}
< {"jsonrpc":"2.0","id":6,"result":{"content":[{"text":"<structuredContent>","type":"text"},{"data":"<png>","mimeType":"image/png","type":"image"}],"isError":false,"structuredContent":{"validation":{"status":"valid"},"value":{"byte_len":"<size>","height":"<size>","width":"<size>"},"versions":{"app":"<app>","document":19,"engine_protocol":"<engine>","operation_api":1},"warnings":[]}}}
