#\#CIF_1.1
# Solid carbon dioxide (dry ice), Pa-3. Hand-written test fixture from the
# published cell parameter (a = 5.624 Å) and oxygen parameter x = 0.1185,
# with the Pa-3 general positions of the International Tables. The
# displacement parameters are illustrative values for testing, not measured.
data_co2
_cell_length_a 5.624
_cell_length_b 5.624
_cell_length_c 5.624
_cell_angle_alpha 90.0
_cell_angle_beta 90.0
_cell_angle_gamma 90.0
_symmetry_space_group_name_H-M 'P a -3'

loop_
_symmetry_equiv_pos_as_xyz
'x,y,z'
'-x+1/2,-y,z+1/2'
'-x,y+1/2,-z+1/2'
'x+1/2,-y+1/2,-z'
'z,x,y'
'z+1/2,-x+1/2,-y'
'-z+1/2,-x,y+1/2'
'-z,x+1/2,-y+1/2'
'y,z,x'
'-y,z+1/2,-x+1/2'
'y+1/2,-z+1/2,-x'
'-y+1/2,-z,x+1/2'
'-x,-y,-z'
'x+1/2,y,-z+1/2'
'x,-y+1/2,z+1/2'
'-x+1/2,y+1/2,z'
'-z,-x,-y'
'-z+1/2,x+1/2,y'
'z+1/2,x,-y+1/2'
'z,-x+1/2,y+1/2'
'-y,-z,-x'
'y,-z+1/2,x+1/2'
'-y+1/2,z+1/2,x'
'y+1/2,z,-x+1/2'

loop_
_atom_site_label
