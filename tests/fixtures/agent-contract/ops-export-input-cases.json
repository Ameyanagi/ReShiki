{
  "rules": [
    {"id": "arguments.object", "cite": "crates/agent/src/ops/catalog.rs:392"},
    {"id": "arguments.no_unknown_fields", "cite": "crates/agent/src/ops/export_input.rs:70"},
    {"id": "xyz.first_frame", "cite": "crates/io/src/qc_input/xyz.rs:46,58,81"},
    {"id": "program.enum", "cite": "crates/agent/src/ops/export_input.rs:55,41"},
    {"id": "job.enum", "cite": "crates/agent/src/ops/export_input.rs:63,42"},
    {"id": "nullable.settings", "cite": "crates/agent/src/ops/export_input.rs:35,76,90"},
    {"id": "charge.integer", "cite": "crates/agent/src/ops/export_input.rs:80,44"},
    {"id": "multiplicity.positive_integer", "cite": "crates/agent/src/ops/export_input.rs:36,82,122"},
    {"id": "cores.positive_integer", "cite": "crates/agent/src/ops/export_input.rs:36,86,122"},
    {"id": "memory_gb.positive_integer", "cite": "crates/agent/src/ops/export_input.rs:36,88,122"}
  ],
  "bases": {
    "default": {"tool": "export_input", "arguments": {"xyz": "3\nwater\nO 0 0 0\nH 0.96 0 0\nH -0.24 0.93 0\n", "program": "gaussian", "job": "single_point", "method": null, "basis": null, "charge": null, "multiplicity": null, "title": null, "cores": null, "memory_gb": null, "extra": null}}
  },
  "cases": [
    {"name": "object_arguments", "rule": "arguments.object", "base": "default", "expect": "both_accept"},
    {"name": "array_arguments", "rule": "arguments.object", "base": "default", "patch": [{"op": "replace", "path": "/arguments", "value": []}], "expect": "both_reject", "message": "Tool arguments must be a JSON object"},
    {"name": "known_fields", "rule": "arguments.no_unknown_fields", "base": "default", "expect": "both_accept"},
    {"name": "unknown_field", "rule": "arguments.no_unknown_fields", "base": "default", "patch": [{"op": "add", "path": "/arguments/unknown", "value": null}], "expect": "both_reject"},
    {"name": "ignores_later_frames", "rule": "xyz.first_frame", "base": "default", "patch": [{"op": "replace", "path": "/arguments/xyz", "value": "3\nwater\nO 0 0 0\nH 0.96 0 0\nH -0.24 0.93 0\nnext frame is invalid"}], "expect": "both_accept"},
    {"name": "xyz_wrong_type", "rule": "xyz.first_frame", "base": "default", "patch": [{"op": "replace", "path": "/arguments/xyz", "value": null}], "expect": "both_reject"},
    {"name": "xyz_missing_coordinate", "rule": "xyz.first_frame", "base": "default", "patch": [{"op": "replace", "path": "/arguments/xyz", "value": "1\ncomment\nH 0 1\n"}], "expect": "decoder_rejects_only", "message": "Invalid XYZ atom 1: expected an element and finite x y z coordinates."},
    {"name": "xyz_invalid_count", "rule": "xyz.first_frame", "base": "default", "patch": [{"op": "replace", "path": "/arguments/xyz", "value": "water"}], "expect": "decoder_rejects_only", "message": "The XYZ input needs an atom count on the first line."},
    {"name": "orca", "rule": "program.enum", "base": "default", "patch": [{"op": "replace", "path": "/arguments/program", "value": "orca"}], "expect": "both_accept"},
    {"name": "gamess", "rule": "program.enum", "base": "default", "patch": [{"op": "replace", "path": "/arguments/program", "value": "gamess"}], "expect": "both_accept"},
    {"name": "xyz_not_a_program", "rule": "program.enum", "base": "default", "patch": [{"op": "replace", "path": "/arguments/program", "value": "xyz"}], "expect": "both_reject"},
    {"name": "program_omitted", "rule": "program.enum", "base": "default", "patch": [{"op": "remove", "path": "/arguments/program"}], "expect": "both_reject"},
    {"name": "optimize", "rule": "job.enum", "base": "default", "patch": [{"op": "replace", "path": "/arguments/job", "value": "optimize"}], "expect": "both_accept"},
    {"name": "opt_freq", "rule": "job.enum", "base": "default", "patch": [{"op": "replace", "path": "/arguments/job", "value": "opt_freq"}], "expect": "both_accept"},
    {"name": "ts_job", "rule": "job.enum", "base": "default", "patch": [{"op": "replace", "path": "/arguments/job", "value": "transition_state"}], "expect": "both_reject"},
    {"name": "cli_job_spelling", "rule": "job.enum", "base": "default", "patch": [{"op": "replace", "path": "/arguments/job", "value": "single-point"}], "expect": "both_reject"},
    {"name": "job_omitted", "rule": "job.enum", "base": "default", "patch": [{"op": "remove", "path": "/arguments/job"}], "expect": "both_reject"},
    {"name": "null_settings_use_defaults", "rule": "nullable.settings", "base": "default", "expect": "both_accept"},
    {"name": "missing_nullable_keys", "rule": "nullable.settings", "base": "default", "patch": [{"op": "remove", "path": "/arguments/method"}, {"op": "remove", "path": "/arguments/basis"}, {"op": "remove", "path": "/arguments/charge"}, {"op": "remove", "path": "/arguments/multiplicity"}, {"op": "remove", "path": "/arguments/title"}, {"op": "remove", "path": "/arguments/cores"}, {"op": "remove", "path": "/arguments/memory_gb"}, {"op": "remove", "path": "/arguments/extra"}], "expect": "schema_rejects_only"},
    {"name": "text_setting_wrong_type", "rule": "nullable.settings", "base": "default", "patch": [{"op": "replace", "path": "/arguments/method", "value": 4}], "expect": "both_reject"},
    {"name": "negative_charge", "rule": "charge.integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/charge", "value": -1}], "expect": "both_accept"},
    {"name": "i32_charge_overflow", "rule": "charge.integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/charge", "value": 2147483648}], "expect": "decoder_rejects_only"},
    {"name": "whole_float_charge", "rule": "charge.integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/charge", "value": 1.0}], "expect": "decoder_rejects_only"},
    {"name": "multiplicity_one", "rule": "multiplicity.positive_integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/multiplicity", "value": 1}], "expect": "both_accept"},
    {"name": "multiplicity_zero", "rule": "multiplicity.positive_integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/multiplicity", "value": 0}], "expect": "both_reject", "message": "multiplicity must be at least 1"},
    {"name": "multiplicity_negative", "rule": "multiplicity.positive_integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/multiplicity", "value": -1}], "expect": "both_reject"},
    {"name": "multiplicity_u32_overflow", "rule": "multiplicity.positive_integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/multiplicity", "value": 4294967296}], "expect": "decoder_rejects_only"},
    {"name": "cores_one", "rule": "cores.positive_integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/cores", "value": 1}], "expect": "both_accept"},
    {"name": "cores_zero", "rule": "cores.positive_integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/cores", "value": 0}], "expect": "both_reject", "message": "cores must be at least 1"},
    {"name": "cores_negative", "rule": "cores.positive_integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/cores", "value": -1}], "expect": "both_reject"},
    {"name": "cores_u32_overflow", "rule": "cores.positive_integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/cores", "value": 4294967296}], "expect": "decoder_rejects_only"},
    {"name": "memory_gb_one", "rule": "memory_gb.positive_integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/memory_gb", "value": 1}], "expect": "both_accept"},
    {"name": "memory_gb_zero", "rule": "memory_gb.positive_integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/memory_gb", "value": 0}], "expect": "both_reject", "message": "memory_gb must be at least 1"},
    {"name": "memory_gb_negative", "rule": "memory_gb.positive_integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/memory_gb", "value": -1}], "expect": "both_reject"},
    {"name": "memory_gb_u32_overflow", "rule": "memory_gb.positive_integer", "base": "default", "patch": [{"op": "replace", "path": "/arguments/memory_gb", "value": 4294967296}], "expect": "decoder_rejects_only"}
  ]
}
