{
  "rules": [
    {
      "id": "arguments.object",
      "cite": "crates/agent/src/ops/catalog.rs:322-330; crates/agent/src/ops/predict_nmr.rs:78"
    },
    {
      "id": "predict_nmr.document_required",
      "cite": "crates/agent/src/ops/predict_nmr.rs:46,50,59"
    },
    {
      "id": "predict_nmr.document_handle",
      "cite": "crates/agent/src/ops/wire.rs:84-89,163-170,182-185"
    },
    {
      "id": "predict_nmr.nucleus",
      "cite": "crates/agent/src/ops/predict_nmr.rs:47,50,60,79-81; crates/chemistry/src/nmr.rs:50-56"
    },
    {
      "id": "predict_nmr.ids_nullable_required",
      "cite": "crates/agent/src/ops/wire.rs:3-10,192-195; crates/agent/src/ops/predict_nmr.rs:48,50,61-62"
    },
    {
      "id": "predict_nmr.ids_nonempty",
      "cite": "crates/agent/src/ops/predict_nmr.rs:41-42,82-89"
    },
    {
      "id": "predict_nmr.ids_items",
      "cite": "crates/agent/src/ops/wire.rs:59-70,145-152,172-175"
    },
    {
      "id": "predict_nmr.ids_count",
      "cite": "crates/agent/src/ops/ids.rs:11-25; crates/agent/src/ops/predict_nmr.rs:90; crates/agent/src/ops/wire.rs:187-190; crates/agent/src/ops/budget.rs:26-27,84"
    },
    {
      "id": "predict_nmr.no_unknown_fields",
      "cite": "crates/agent/src/ops/predict_nmr.rs:57-58"
    }
  ],
  "bases": {
    "whole": {"tool": "predict_nmr", "arguments": {"document": "doc_0123456789abcdef0123456789abcdef", "nucleus": "1H", "ids": null}},
    "selection": {"tool": "predict_nmr", "arguments": {"document": "doc_0123456789abcdef0123456789abcdef", "nucleus": "13C", "ids": ["1", "12"]}}
  },
  "cases": [
    {"name": "arguments_object", "rule": "arguments.object", "base": "whole", "expect": "both_accept"},
    {"name": "arguments_array", "rule": "arguments.object", "base": "whole", "patch": [{"op": "replace", "path": "/arguments", "value": ["doc_1", "1H", null]}], "expect": "both_reject", "message": "Tool arguments must be a JSON object"},

    {"name": "document_given", "rule": "predict_nmr.document_required", "base": "selection", "expect": "both_accept"},
    {"name": "document_omitted", "rule": "predict_nmr.document_required", "base": "whole", "patch": [{"op": "remove", "path": "/arguments/document"}], "expect": "both_reject", "message": "missing field `document`"},
    {"name": "document_null", "rule": "predict_nmr.document_required", "base": "whole", "patch": [{"op": "replace", "path": "/arguments/document", "value": null}], "expect": "both_reject"},

    {"name": "handle_64_characters", "rule": "predict_nmr.document_handle", "base": "whole", "patch": [{"op": "replace", "path": "/arguments/document", "value": {"$text": "a", "count": 64}}], "expect": "both_accept"},
    {"name": "handle_65_characters", "rule": "predict_nmr.document_handle", "base": "whole", "patch": [{"op": "replace", "path": "/arguments/document", "value": {"$text": "a", "count": 65}}], "expect": "both_reject", "message": "Document handles are 1 to 64 characters of A-Z, a-z, 0-9, \"_\" and \"-\""},
    {"name": "handle_empty", "rule": "predict_nmr.document_handle", "base": "whole", "patch": [{"op": "replace", "path": "/arguments/document", "value": ""}], "expect": "both_reject"},

    {"name": "nucleus_1h", "rule": "predict_nmr.nucleus", "base": "whole", "expect": "both_accept"},
    {"name": "nucleus_13c", "rule": "predict_nmr.nucleus", "base": "selection", "expect": "both_accept"},
    {"name": "nucleus_variant_name", "rule": "predict_nmr.nucleus", "base": "whole", "patch": [{"op": "replace", "path": "/arguments/nucleus", "value": "H1"}], "expect": "both_reject", "message": "nucleus must be 1H or 13C"},
    {"name": "nucleus_lowercase", "rule": "predict_nmr.nucleus", "base": "whole", "patch": [{"op": "replace", "path": "/arguments/nucleus", "value": "13c"}], "expect": "both_reject", "message": "nucleus must be 1H or 13C"},
    {"name": "nucleus_other", "rule": "predict_nmr.nucleus", "base": "whole", "patch": [{"op": "replace", "path": "/arguments/nucleus", "value": "15N"}], "expect": "both_reject", "message": "nucleus must be 1H or 13C"},
    {"name": "nucleus_omitted", "rule": "predict_nmr.nucleus", "base": "whole", "patch": [{"op": "remove", "path": "/arguments/nucleus"}], "expect": "both_reject", "message": "missing field `nucleus`"},
    {"name": "nucleus_null", "rule": "predict_nmr.nucleus", "base": "whole", "patch": [{"op": "replace", "path": "/arguments/nucleus", "value": null}], "expect": "both_reject"},
    {"name": "nucleus_number", "rule": "predict_nmr.nucleus", "base": "whole", "patch": [{"op": "replace", "path": "/arguments/nucleus", "value": 1}], "expect": "both_reject"},

    {"name": "ids_null", "rule": "predict_nmr.ids_nullable_required", "base": "whole", "expect": "both_accept"},
    {"name": "ids_omitted", "rule": "predict_nmr.ids_nullable_required", "base": "whole", "patch": [{"op": "remove", "path": "/arguments/ids"}], "expect": "schema_rejects_only"},
    {"name": "ids_string", "rule": "predict_nmr.ids_nullable_required", "base": "whole", "patch": [{"op": "replace", "path": "/arguments/ids", "value": "1"}], "expect": "both_reject"},

    {"name": "ids_one", "rule": "predict_nmr.ids_nonempty", "base": "selection", "patch": [{"op": "replace", "path": "/arguments/ids", "value": ["1"]}], "expect": "both_accept"},
    {"name": "ids_empty", "rule": "predict_nmr.ids_nonempty", "base": "whole", "patch": [{"op": "replace", "path": "/arguments/ids", "value": []}], "expect": "both_reject", "message": "ids must list at least one atom, or be null for the whole drawing"},

    {"name": "id_below_u64_max", "rule": "predict_nmr.ids_items", "base": "selection", "patch": [{"op": "replace", "path": "/arguments/ids", "value": ["18446744073709551614"]}], "expect": "both_accept"},
    {"name": "id_duplicates", "rule": "predict_nmr.ids_items", "base": "selection", "patch": [{"op": "replace", "path": "/arguments/ids", "value": ["1", "1"]}], "expect": "both_accept"},
    {"name": "id_zero", "rule": "predict_nmr.ids_items", "base": "selection", "patch": [{"op": "replace", "path": "/arguments/ids/0", "value": "0"}], "expect": "both_reject", "message": "Object IDs are decimal strings such as \"12\""},
    {"name": "id_number", "rule": "predict_nmr.ids_items", "base": "selection", "patch": [{"op": "replace", "path": "/arguments/ids/0", "value": 1}], "expect": "both_reject"},
    {"name": "id_u64_max", "rule": "predict_nmr.ids_items", "base": "selection", "patch": [{"op": "replace", "path": "/arguments/ids/0", "value": "18446744073709551615"}], "expect": "decoder_rejects_only", "message": "Object IDs are decimal strings such as \"12\""},

    {"name": "ids_at_max_ids", "rule": "predict_nmr.ids_count", "base": "whole", "patch": [{"op": "replace", "path": "/arguments/ids", "value": {"$repeat": "7", "count": 5000}}], "expect": "both_accept"},
    {"name": "ids_over_max_ids", "rule": "predict_nmr.ids_count", "base": "whole", "patch": [{"op": "replace", "path": "/arguments/ids", "value": {"$repeat": "7", "count": 5001}}], "expect": "both_reject", "message": "5001 object IDs were given; at most 5000 are allowed per request"},

    {"name": "known_fields_only", "rule": "predict_nmr.no_unknown_fields", "base": "selection", "expect": "both_accept"},
    {"name": "unknown_null_field", "rule": "predict_nmr.no_unknown_fields", "base": "whole", "patch": [{"op": "add", "path": "/arguments/solvent", "value": null}], "expect": "both_reject", "message": "unknown field `solvent`, expected one of `document`, `nucleus`, `ids`"}
  ]
}
