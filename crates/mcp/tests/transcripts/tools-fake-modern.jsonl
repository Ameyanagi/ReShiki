# cancelled it, the writer drops it.
> {"jsonrpc":"2.0","id":20,"method":"tools/call","params":{"name":"fail_cancelled","arguments":{},"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}
