# Tool calls on the scripted FakeHost (tests/common/fake_host.rs), MCP
# 2026-07-28: every request carries _meta. '>' lines are sent; '<' lines
# are the expected output.
# Tools are listed in the host's order, with every hint and no outputSchema.
> {"jsonrpc":"2.0","id":1,"method":"tools/list","params":{"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}
< {"jsonrpc":"2.0","id":1,"result":{"resultType":"complete","ttlMs":0,"cacheScope":"private","tools":[{"name":"echo","title":"Echo","description":"Returns its arguments.","inputSchema":{"type":"object"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"png","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":true}},{"name":"pdf","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"svg","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"},"annotations":{"readOnlyHint":true,"destructiveHint":true,"idempotentHint":false,"openWorldHint":true}},{"name":"fail_unknown_tool","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"fail_invalid_arguments","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"fail_unknown_document","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"fail_unknown_object","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"fail_stale","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"fail_busy","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"fail_budget","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"fail_timeout","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"fail_rejected","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"fail_unsupported","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"fail_access_denied","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"fail_failed","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"fail_cancelled","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"slow","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"panic","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{},"type":"object"}},{"name":"big","description":"A scripted test tool.","inputSchema":{"additionalProperties":false,"properties":{"n":{"minimum":0,"type":"integer"}},"required":["n"],"type":"object"}}]}}
# A value is structuredContent, with a compact text copy first.
> {"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"echo","arguments":{"smiles":"CCO","quoted":"\"x\"\n","n":1.5},"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}
< {"jsonrpc":"2.0","id":2,"result":{"resultType":"complete","content":[{"type":"text","text":"{\"n\":1.5,\"quoted\":\"\\\"x\\\"\\n\",\"smiles\":\"CCO\"}"}],"structuredContent":{"n":1.5,"quoted":"\"x\"\n","smiles":"CCO"},"isError":false}}
# Null and omitted arguments are both {}.
> {"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"echo","arguments":null,"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}
< {"jsonrpc":"2.0","id":3,"result":{"resultType":"complete","content":[{"type":"text","text":"{}"}],"structuredContent":{},"isError":false}}
> {"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"echo","_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}
< {"jsonrpc":"2.0","id":4,"result":{"resultType":"complete","content":[{"type":"text","text":"{}"}],"structuredContent":{},"isError":false}}
# Images are base64 image content.
> {"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"png","arguments":{},"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}
< {"jsonrpc":"2.0","id":5,"result":{"resultType":"complete","content":[{"type":"text","text":"{\"height\":1,\"width\":1}"},{"type":"image","data":"iVBORw0KGgoAAAANSUhEUgD//g==","mimeType":"image/png"}],"structuredContent":{"height":1,"width":1},"isError":false}}
# Binary files are embedded base64 blobs at reshiki:result/<name>.
> {"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"pdf","arguments":{},"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}
< {"jsonrpc":"2.0","id":6,"result":{"resultType":"complete","content":[{"type":"text","text":"{\"format\":\"pdf\"}"},{"type":"resource","resource":{"uri":"reshiki:result/drawing.pdf","mimeType":"application/pdf","blob":"JVBERi0xLjcKJeLjz9MKAP8="}}],"structuredContent":{"format":"pdf"},"isError":false}}
# Textual files that are UTF-8 are embedded text.
> {"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"svg","arguments":{},"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}
< {"jsonrpc":"2.0","id":7,"result":{"resultType":"complete","content":[{"type":"text","text":"{\"format\":\"svg\"}"},{"type":"resource","resource":{"uri":"reshiki:result/drawing.svg","mimeType":"image/svg+xml","text":"<svg xmlns=\"http://www.w3.org/2000/svg\"><title>\"α\" \\ &amp;\n</title></svg>"}}],"structuredContent":{"format":"svg"},"isError":false}}
# A host's unknown_tool is -32602, like a name outside the catalog.
> {"jsonrpc":"2.0","id":8,"method":"tools/call","params":{"name":"fail_unknown_tool","arguments":{},"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}
< {"jsonrpc":"2.0","id":8,"error":{"code":-32602,"message":"Unknown tool: fail_unknown_tool"}}
