# A panicking call is -32603, and serving goes on.
> {"jsonrpc":"2.0","id":22,"method":"tools/call","params":{"name":"panic","arguments":{},"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}
< {"jsonrpc":"2.0","id":22,"error":{"code":-32603,"message":"Internal error"}}
> {"jsonrpc":"2.0","id":23,"method":"tools/call","params":{"name":"echo","arguments":{"after":"panic"},"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}
< {"jsonrpc":"2.0","id":23,"result":{"resultType":"complete","content":[{"type":"text","text":"{\"after\":\"panic\"}"}],"structuredContent":{"after":"panic"},"isError":false}}
# Escaped text is copied exactly.
> {"jsonrpc":"2.0","id":24,"method":"tools/call","params":{"name":"big","arguments":{"n":4},"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}
< {"jsonrpc":"2.0","id":24,"result":{"resultType":"complete","content":[{"type":"text","text":"{\"text\":\"\\\"\\\\a\\n\"}"}],"structuredContent":{"text":"\"\\a\n"},"isError":false}}
