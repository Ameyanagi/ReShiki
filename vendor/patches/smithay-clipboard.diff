+        let Command::Rich(crate::rich::Operation::Read { completion, .. }) =
+            commands.try_recv().unwrap()
+        else {
+            panic!()
+        };
+        let bytes = vec![0, 255, b'\r', b'\n', 128];
+        ReadReply::Binary {
+            completion,
+            mime_type: "image/png".into(),
