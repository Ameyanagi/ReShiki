+        let (sender, receiver) = std::sync::mpsc::channel();
+        ReadReply::Text { sender, mime_type: MimeType::TextPlain }
+            .finish(Ok(b"a\r\nb\rc".to_vec()));
+        assert_eq!(receiver.try_recv().unwrap().unwrap(), "a\nb\nc");
