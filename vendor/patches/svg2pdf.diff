+struct EmbeddedSubset {
+    data: Vec<u8>,
+    is_cff: bool,
+    bbox: Option<ttf_parser::Rect>,
+    widths: Vec<f32>,
+}
+
 fn subset_font(
     font_data: &[u8],
     index: u32,
     glyph_remapper: &GlyphRemapper,
     id: fontdb::ID,
-) -> Result<Vec<u8>> {
+    variation_weight: Option<u16>,
+) -> Result<EmbeddedSubset> {
     let data = font_data;
-    let subsetted =
-        subsetter::subset(data, index, glyph_remapper).map_err(|_| SubsetError(id))?;
+    let source = ttf_parser::RawFace::parse(data, index).map_err(|_| SubsetError(id))?;
+    let subsetted = if variation_weight.is_some() || source.table(CFF2).is_some() {
+        let coordinates: Vec<_> = variation_weight
+            .into_iter()
+            .map(|weight| (subsetter::Tag::new(b"wght"), f32::from(weight)))
+            .collect();
+        subsetter::subset_with_variations(data, index, &coordinates, glyph_remapper)
+    } else {
+        subsetter::subset(data, index, glyph_remapper)
+    }
+    .map_err(|_| SubsetError(id))?;
     let mut data = subsetted.as_ref();
+    let subset_face = Face::parse(data, 0).map_err(|_| SubsetError(id))?;
+    // The PDF CID is the new glyph ID. Read advances from the actual embedded
+    // instance, not the source face's default hmtx or old glyph numbering.
+    let widths = (0..glyph_remapper.num_gids())
+        .map(|id| {
+            let width = subset_face.glyph_hor_advance(GlyphId(id)).unwrap_or(0);
+            (f64::from(width) / f64::from(subset_face.units_per_em()) * 1000.0) as f32
+        })
+        .collect();
+    let bbox = (0..subset_face.number_of_glyphs())
+        .filter_map(|id| subset_face.glyph_bounding_box(GlyphId(id)))
+        .reduce(|a, b| ttf_parser::Rect {
+            x_min: a.x_min.min(b.x_min),
+            y_min: a.y_min.min(b.y_min),
+            x_max: a.x_max.max(b.x_max),
+            y_max: a.y_max.max(b.y_max),
+        });
 
     // Extract the standalone CFF font program if applicable.
     let face = ttf_parser::RawFace::parse(data, 0).map_err(|_| SubsetError(id))?;
-    if let Some(cff) = face.table(CFF) {
+    let cff = face.table(CFF);
+    if let Some(cff) = cff {
         data = cff;
     }
 
