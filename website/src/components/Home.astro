---
import { Icon } from "@astrojs/starlight/components";

const workflows = [
  {
    number: "01",
    title: "Build a molecule",
    description: "Draw bonds, choose atoms, and attach a template.",
    href: "/guide/first-molecule/",
  },
  {
    number: "02",
    title: "Arrange a reaction",
    description: "Place molecules and arrows, then assign reaction roles.",
    href: "/guide/reactions/",
  },
  {
    number: "03",
    title: "Share your figure",
    description: "Copy editable structures or export SVG, PDF, and PNG.",
    href: "/guide/sharing/",
  },
];
const guides = [
  { title: "Templates", href: "/guide/templates/" },
  { title: "Editing", href: "/guide/editing/" },
  { title: "Shortcuts", href: "/guide/shortcuts/" },
  { title: "Assistant", href: "/guide/assistant/" },
  { title: "Figures", href: "/guide/figures/" },
  { title: "Color palettes", href: "/guide/color-palettes/" },
];
---

<div class="reshiki-home not-content">
  <p class="home-release">
    <a href="https://github.com/Ameyanagi/ReShiki/releases/latest" data-latest-release>
      Stable release<span data-release-version></span>
      <span aria-hidden="true">↗</span>
    </a>
  </p>
  <p class="home-platforms">
    <a href="/developer/changes-0.11/">What’s new in 0.11</a>
    <span aria-hidden="true">/</span>
    <a href="/guide/shortcuts/">Shortcuts and editable examples</a>
  </p>
  <p class="home-platforms">
    macOS · Windows · Linux
    <span aria-hidden="true">/</span>
    <a href="/guide/install/">Installation guide</a>
    <span aria-hidden="true">/</span>
    <a href="/guide/install/#nightly-builds">Nightly builds</a>
    <span aria-hidden="true">/</span>
    <a href="https://github.com/Ameyanagi/ReShiki/blob/main/LICENSE">MIT or Apache-2.0</a>
  </p>
  <p class="home-platforms">
    <a href="/developer/code-signing-policy/">Code signing policy</a>
    <span aria-hidden="true">/</span>
    <a href="/developer/privacy-policy/">Privacy policy</a>
  </p>

  <nav class="home-support" aria-label="Support ReShiki">
    <a href="https://github.com/sponsors/Ameyanagi">
      <Icon name="heart" size="1.1rem" />
      Sponsor this work
    </a>
    <a href="https://github.com/Ameyanagi/ReShiki">
      <Icon name="star" size="1.1rem" />
      Star on GitHub
    </a>
  </nav>

  <figure class="home-workspace" id="promo-video">
    <video
      controls
      playsinline
      preload="none"
      poster="/media/reshiki-promo-poster.png?v=0.9.1"
      width="1920"
      height="1080"
      aria-label="ReShiki full tour, 2 minutes 46 seconds. English captions are included in the video."
      aria-describedby="promo-caption"
    >
      <source src="/media/reshiki-promo.mp4?v=0.9.1" type="video/mp4" />
      <a href="/media/reshiki-promo.mp4?v=0.9.1">Download the full ReShiki tour</a>.
    </video>
    <figcaption id="promo-caption">
      Full tour · 2:46 · English captions
      <span aria-hidden="true"> · </span>
      <a href="/media/reshiki-promo.mp4?v=0.9.1" download>Download video</a>
      <span aria-hidden="true"> · </span>
      <a href="/manual/workspace.png">View the workspace</a>
      <div class="home-video-update">
        <a href="/developer/changes-0.9.1/#release-highlights">
          Release highlights · 0.9.1 · 2:10 <span aria-hidden="true">→</span>
        </a>
      </div>
    </figcaption>
  </figure>

  <section class="home-manual" aria-labelledby="manual-title">
    <div class="home-section-heading">
      <h2 id="manual-title">Start drawing</h2>
      <p>From your first bond to a finished figure.</p>
    </div>
    <div class="home-workflows">
      {
        workflows.map((workflow) => (
          <a class="home-workflow" href={workflow.href}>
            <span class="home-step" aria-hidden="true">{workflow.number}</span>
            <h3>{workflow.title}<span aria-hidden="true">↗</span></h3>
            <p>{workflow.description}</p>
          </a>
        ))
      }
    </div>
    <nav class="home-guide-links" aria-label="More drawing guides">
      {guides.map((guide) => <a href={guide.href}>{guide.title}<span aria-hidden="true">→</span></a>)}
    </nav>
  </section>

  <section class="home-tour" aria-labelledby="tour-title">
    <div class="home-section-heading"><h2 id="tour-title">A look inside</h2></div>
    <div class="home-tour-grid">
      <figure>
        <a href="/guide/templates/"><img src="/manual/template-connect.png" alt="Choose a template atom and connect it to the drawing." width="2560" height="1704" loading="lazy" /></a>
        <figcaption><strong>Build with templates</strong><span>Choose the attachment point, then connect or fuse.</span></figcaption>
      </figure>
      <figure>
        <a href="/guide/assistant/"><img src="/manual/assistant-review.png" alt="Review an assistant drawing proposal before applying it to the canvas." width="2560" height="1704" loading="lazy" /></a>
        <figcaption><strong>Draw with the assistant</strong><span>Follow its progress, inspect a preview, and apply a reviewed scheme.</span></figcaption>
      </figure>
    </div>
  </section>

  <div class="home-developers">
    <span>Building with ReShiki?</span>
    <a href="/developer/development/">Developer docs <span aria-hidden="true">→</span></a>
  </div>
  <p class="home-name">
    ReShiki <span lang="ja">（リシキ）</span> · REinvention of the wheel for drawing chemical structure.
    Shiki is <span lang="ja">式</span>, as in chemical equation. R is also Rust; RE is also reaction.
  </p>
</div>

<script>
  async function showLatestRelease() {
    const version = document.querySelector<HTMLElement>("[data-release-version]");
    if (!version) return;

    try {
      const response = await fetch("https://api.github.com/repos/Ameyanagi/ReShiki/releases/latest", {
        headers: { Accept: "application/vnd.github+json" },
        signal: AbortSignal.timeout(5000),
      });
      if (!response.ok) return;
      const release = await response.json();
      if (
        release.draft !== false ||
        release.prerelease !== false ||
        typeof release.tag_name !== "string" ||
        !/^v\d+\.\d+\.\d+$/.test(release.tag_name)
      ) return;

      version.textContent = ` · ${release.tag_name}`;
    } catch {
      // Keep the working release link when GitHub is unavailable.
    }
  }

  void showLatestRelease();
  document.addEventListener("astro:page-load", showLatestRelease);
</script>
