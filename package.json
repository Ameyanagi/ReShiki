{
  "name": "reshiki-development",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "workspaces": [
    "website"
  ],
  "type": "module",
  "scripts": {
    "prepare": "bun run --bun lefthook install",
    "docs:dev": "bun run --cwd website dev",
    "docs:build": "bun run --cwd website build",
    "docs:check": "bun run --cwd website check",
    "lint:js": "bun run --bun oxlint --deny-warnings website integrations/office packages/editor",
    "format:check": "bun run --bun oxfmt --check .",
    "format": "bun run --bun oxfmt .",
    "check": "bun run lint:js && bun run format:check && bun run docs:check"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "postcss-selector-parser": "7.1.6",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2",
    "undici": "8.12.2",
    "vite": "8.3.3",
    "zod": "4.6.6"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
