const main = document.getElementById("main");
const strip = document.getElementById("strip");
const tiles = {};
for (const key of Object.keys(STYLE_NAMES)) {
  const b = document.createElement("button");
  b.className = "tile"; b.id = "t-" + key; b.setAttribute("aria-pressed", String(key === state.style));
  b.innerHTML = `<canvas aria-hidden="true"></canvas><b>${STYLE_NAMES[key][0]}</b><span>${STYLE_NAMES[key][1]}</span>`;
  b.addEventListener("click", () => set("style", key));
  strip.appendChild(b); tiles[key] = b;
}

function drawAll() {
  const o = { mol: state.mol, style: state.style, look: state.look, h: state.h, labels: state.labels, depth: state.depth, persp: state.persp, bg: state.bg, R: state.R, layout: state.layout };
  render(main, { ...o, morph: state.morph });
  for (const key in tiles) render(tiles[key].querySelector("canvas"), { ...o, style: key, bg: "none", labels: "none", morph: 1 });
  if (state.layout === "view" && state.rep !== "3d") draw2d();
  const mol = MOLS[state.mol];
  document.getElementById("meta").textContent = `${mol.formula} · ${mol.atoms.length} atoms · MMFF94s conformer`;
}
let raf = 0;
const redraw = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(drawAll); };

function pressGroup(attr, value) {
  document.querySelectorAll(`[data-${attr}]`).forEach(b => b.setAttribute("aria-pressed", String(b.dataset[attr] === value)));
}
function set(key, value) {
  state[key] = value;
  const attr = { style: "style", look: "look", h: "h", labels: "labels", bg: "bg", mol: "mol", layout: "layout", ff: "ff" }[key];
  if (attr) pressGroup(attr, value);
  if (key === "style") for (const k in tiles) tiles[k].setAttribute("aria-pressed", String(k === value));
  if (key === "bg") document.getElementById("modelbox").classList.toggle("card", value === "card");
  if (key === "mol") {
    state.R = initialView(MOLS[value]); state.stale = false; document.getElementById("badge").hidden = true;
    document.getElementById("docname").textContent = { caffeine: "caffeine.rsk", ibuprofen: "ibuprofen.rsk", crown: "18-crown-6.rsk" }[value];
    draw2d();
  }
  if (key === "layout") { draw2d(); toast(value === "view" ? "2D drawing flattened from the 3D view" : "Original 2D drawing restored"); }
  redraw();
}

/* ---------- 2D / 3D switching ---------- */
const paper = document.getElementById("paper"), box2d = document.getElementById("box2d"), box3d = document.getElementById("modelbox");
let toastTimer = 0;
function toast(text) {
  const t = document.getElementById("toast");
  t.textContent = text; t.style.opacity = "1";
  clearTimeout(toastTimer); toastTimer = setTimeout(() => { t.style.opacity = "0"; }, 1800);
}
function animateMorph(from, to, done) {
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) { state.morph = to; drawAll(); done && done(); return; }
  const t0 = performance.now(), dur = 750;
  const step = now => {
    const k = Math.min(1, (now - t0) / dur);
    state.morph = from + (to - from) * k; drawAll();
    if (k < 1) requestAnimationFrame(step); else done && done();
  };
  requestAnimationFrame(step);
}
function layoutFields() {
  document.getElementById("f-layout").style.display = state.rep === "3d" ? "none" : "grid";
  document.getElementById("f-conformer").style.display = state.rep === "2d" ? "none" : "grid";
  document.getElementById("sec3d").style.display = state.rep === "2d" ? "none" : "grid";
  document.getElementById("rep-note").textContent = {
    "2d": "Shown as a 2D drawing. Its 3D conformer is kept, so switching back restores the same model and view.",
    "3d": "Shown as a 3D model in place of the drawing. The 2D layout is kept for switching back.",
    both: "One molecule, drawn twice. Edits to the 2D drawing mark the model out of date.",
  }[state.rep];
}
function setRep(next) {
  const prev = state.rep;
  if (next === prev) return;
  idle = false;
  state.rep = next; pressGroup("rep", next); layoutFields();
  paper.dataset.rep = next;
  if (next === "2d") {
    // Fold the model back into the flat drawing, then hand over to the 2D drawing.
    box2d.classList.add("off"); box3d.classList.remove("off");
    paper.dataset.rep = prev === "both" ? "both" : "3d";
    animateMorph(1, 0, () => {
      paper.dataset.rep = "2d"; box3d.classList.add("off"); box2d.classList.remove("off"); state.morph = 1; draw2d();
    });
    toast("Shown as 2D · the 3D conformer is kept");
  } else {
    box3d.classList.remove("off");
    if (next === "3d") box2d.classList.add("off"); else box2d.classList.remove("off");
    if (prev === "2d") { state.morph = 0; drawAll(); animateMorph(0, 1); toast(next === "3d" ? "Converted to 3D · MMFF94s conformer" : "3D model added beside the drawing"); }
    else { drawAll(); }
  }
}
document.querySelectorAll("[data-rep]").forEach(b => b.addEventListener("click", () => setRep(b.dataset.rep)));
document.querySelectorAll("[data-layout]").forEach(b => b.addEventListener("click", () => set("layout", b.dataset.layout)));
document.querySelectorAll("[data-ff]").forEach(b => b.addEventListener("click", () => { set("ff", b.dataset.ff); toast(`Conformer: ${b.dataset.ff} (prototype shows MMFF94s)`); }));
document.querySelectorAll("[data-mol]").forEach(b => b.addEventListener("click", () => set("mol", b.dataset.mol)));
document.querySelectorAll(".styles [data-style]").forEach(b => b.addEventListener("click", () => set("style", b.dataset.style)));
document.querySelectorAll("[data-look]").forEach(b => b.addEventListener("click", () => set("look", b.dataset.look)));
document.querySelectorAll("[data-h]").forEach(b => b.addEventListener("click", () => set("h", b.dataset.h)));
document.querySelectorAll("[data-labels]").forEach(b => b.addEventListener("click", () => set("labels", b.dataset.labels)));
document.querySelectorAll("[data-bg]").forEach(b => b.addEventListener("click", () => set("bg", b.dataset.bg)));
for (const [id, key] of [["depth", "depth"], ["persp", "persp"]]) {
  const input = document.getElementById(id), out = document.getElementById(id + "-out");
  input.addEventListener("input", () => { state[key] = input.value / 100; out.textContent = input.value + "%"; redraw(); });
}
document.getElementById("reset").addEventListener("click", () => { state.R = initialView(MOLS[state.mol]); redraw(); });
document.getElementById("edit").addEventListener("click", () => { state.stale = true; document.getElementById("badge").hidden = false; });
document.getElementById("update").addEventListener("click", () => { state.stale = false; document.getElementById("badge").hidden = true; });

let drag = null;
main.addEventListener("pointerdown", e => { drag = { x: e.clientX, y: e.clientY, shift: e.shiftKey }; main.setPointerCapture(e.pointerId); });
main.addEventListener("pointermove", e => {
  if (!drag) return;
  const dx = e.clientX - drag.x, dy = e.clientY - drag.y; drag.x = e.clientX; drag.y = e.clientY;
  state.R = drag.shift || e.shiftKey ? mul(rotZ(-dx * 0.01), state.R) : mul(mul(rotY(dx * 0.01), rotX(dy * 0.01)), state.R);
  redraw();
});
const end = () => { drag = null; };
main.addEventListener("pointerup", end); main.addEventListener("pointercancel", end);
main.addEventListener("dblclick", () => { state.R = initialView(MOLS[state.mol]); redraw(); });

/* Slow idle turn on load so the 3D reads at a glance; stops at the first touch. */
let idle = !window.matchMedia("(prefers-reduced-motion: reduce)").matches, spun = 0;
function spin() { if (!idle || spun > 70) return; state.R = mul(rotY(0.012), state.R); spun++; drawAll(); requestAnimationFrame(spin); }
main.addEventListener("pointerdown", () => { idle = false; });

state.R = initialView(MOLS[state.mol]);
layoutFields(); draw2d(); drawAll(); requestAnimationFrame(spin);
new ResizeObserver(redraw).observe(document.body);
</script>

