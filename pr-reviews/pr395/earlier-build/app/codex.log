    fn document_settings(&self) -> [Element<'_, Message>; 3] {
        use super::document_styles::Choice;
        use reshiki::document_styles::Preset;
        let current = Preset::ALL
            .into_iter()
            .find(|p| p.style() == self.tab.doc.drawing_style)
