import AppKit
let base = CommandLine.arguments[1]
for name in [\"02-3d-shown.png\", \"04-rotate-released.png\", \"06-shift-roll.png\", \"07-double-click-reset.png\", \"08-resized.png\", \"09-resized-then-rotated.png\"] {
