    <script type="module">
      import { mount } from "../src/editor.js";

      const $ = (id) => document.getElementById(id);
      const show = (text) => ($("output").textContent = text);
      let changes = 0;
      const editor = await mount($("editor"), {
        onChange: () => ($("changes").textContent = `${++changes} changes`),
      });
      const run = (action) => () => action().catch((error) => show(`Error: ${error.message}`));

      $("caffeine").onclick = run(() => editor.load("CN1C=NC2=C1C(=O)N(C(=O)N2C)C", "smiles"));
      $("file").onchange = run(async () => {
        const file = $("file").files[0];
        const format = file.name
          .split(".")
          .pop()
          .toLowerCase()
          .replace(/^(sdf|smi)$/, "auto");
        await editor.load(new Uint8Array(await file.arrayBuffer()), format);
      });
      $("save").onclick = run(async () => show(await editor.save($("format").value)));
      $("svg").onclick = run(async () => {
        const svg = await editor.exportImage("svg");
        const url = URL.createObjectURL(new Blob([svg], { type: "image/svg+xml" }));
        $("preview").innerHTML = `<img alt="SVG export" src="${url}">`;
      });
      $("png").onclick = run(async () => {
        const png = await editor.exportImage("png");
        const url = URL.createObjectURL(new Blob([png], { type: "image/png" }));
        $("preview").innerHTML = `<img alt="PNG export" src="${url}">`;
      });
      window.editor = editor;
    </script>
  </body>
</html>
    Subscription::batch([app.subscription(), Subscription::run(requests)])
