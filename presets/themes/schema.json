{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReShiki color theme v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "base", "light", "dark"],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "author": {
      "type": "string",
      "maxLength": 2048
    },
    "source": {
      "type": "string",
      "maxLength": 2048
    },
    "license": {
      "type": "string",
      "maxLength": 2048
    },
    "base": {
      "enum": ["publication", "presentation", "pastel", "jmol"]
    },
    "light": {
      "$ref": "#/$defs/palette"
    },
    "dark": {
      "$ref": "#/$defs/palette"
    }
  },
  "$defs": {
    "color": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["oklch"],
          "properties": {
            "oklch": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.4
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      ]
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elements": {
          "type": "object",
          "propertyNames": {
