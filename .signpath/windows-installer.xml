<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
    <parameter name="architecture" required="true" />
  </parameters>
  <!-- CI restricts architecture to x64 or arm64 before submitting this request. -->
  <zip-file>
    <pe-file path="reshiki-${version}-windows-${architecture}-setup.exe"
             product-name="ReShiki"
             product-version="${version}"
             file-version="${version}">
      <authenticode-sign hash-algorithm="sha256" />
    </pe-file>
  </zip-file>
</artifact-configuration>
